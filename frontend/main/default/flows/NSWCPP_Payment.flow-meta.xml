    <description>Example payment flow using NSW CPP</description>
    <environments>Default</environments>
    <formulas>
        <name>CustomerReference</name>
        <dataType>String</dataType>
        <expression>IF((ISBLANK({!Customer_Reference}) || ISNULL({!Customer_Reference})), &quot;None&quot;, {!Customer_Reference})</expression>
    </formulas>
    <formulas>
        <name>ProductDescription</name>
        <dataType>String</dataType>
        <expression>{!Quantity.selectedChoiceValues} &amp; &quot;x &quot; &amp; {!Service.selectedChoiceValues}</expression>
    </formulas>
    <formulas>
        <name>QuantityN</name>
        <dataType>Number</dataType>
        <expression>VALUE({!QuantityS})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>QuantityS</name>
        <dataType>String</dataType>
        <expression>{!Quantity.selectedChoiceValues}</expression>
    </formulas>
    <formulas>
        <name>ServiceS</name>
        <dataType>String</dataType>
        <expression>{!Service.selectedChoiceLabels}</expression>
    </formulas>
    <formulas>
        <name>TotalPrice</name>
        <dataType>Currency</dataType>
        <expression>{!QuantityN} * {!UnitPrice}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UnitPrice</name>
        <dataType>Currency</dataType>
        <expression>IF({!ServiceS} == {!ServiceIndividual}, 45.0, 750.0)</expression>
        <scale>2</scale>
    </formulas>
